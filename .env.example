# --- Base de données (PostgreSQL local ou Supabase) -------------------------
# Supabase : Project Settings > Database > Connection string (URI, mode "Session")
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- IA : Anthropic Claude (génération de questions + évaluation) -----------
# Sans clé, Voxa utilise un moteur heuristique local (démo fonctionnelle hors-ligne).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Reconnaissance vocale de secours : OpenAI Whisper (optionnel) ----------
# La Web Speech API du navigateur est utilisée en priorité.
OPENAI_API_KEY=

# --- Paiements : Stripe (optionnel — sans clé, le mode démo active Premium) -
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=          # price_... (abonnement 7,99 €/mois)

# --- Emails transactionnels : vérification et mot de passe oublié -----------
RESEND_API_KEY=
EMAIL_FROM=Voxa <noreply@votre-domaine.com>

# --- OAuth Google (optionnel — sinon bouton désactivé avec message) ---------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URL publique de l'app (webhooks Stripe, redirections) -------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
